# ===== paTrack – configuration =====

# Public address of the app (email links, the OIDC callback)
PATRACK_URL=https://patrack.example.com

# Time zone
TZ=Europe/Rome

# Sign-up: "open" (anyone) or "closed" (only through an invitation link)
PATRACK_SIGNUP=closed

# In production behind HTTPS: cookies only over secure connections
PATRACK_COOKIE_SECURE=1
# Set to 1 when a reverse proxy sits in front (nginx, Caddy, Traefik…)
PATRACK_PROXY=1
# How long a sign-in lasts on a device (days)
PATRACK_SESSION_DAYS=30

# ----- Sign-in: Pocket ID (the same provider as doTrack and eaTrack) -----
# In Pocket ID: OIDC Clients → Add, callback URL <PATRACK_URL>/api/oidc/pocketid/callback
PATRACK_OIDC=pocketid
PATRACK_OIDC_POCKETID_ISSUER=https://id.example.com
PATRACK_OIDC_POCKETID_ID=
PATRACK_OIDC_POCKETID_SECRET=
PATRACK_OIDC_POCKETID_NAME=Pocket ID
# Email/password sign-in: 0 = only Pocket ID (passkeys, Face ID). Keep 1 until you have signed in once with Pocket ID.
PATRACK_PASSWORD_LOGIN=1

# ----- Email sent by paTrack (address confirmation, import summaries). Without SMTP emails are only logged. -----
PATRACK_SMTP_HOST=
PATRACK_SMTP_PORT=587
PATRACK_SMTP_USER=
PATRACK_SMTP_PASSWORD=
PATRACK_MAIL_FROM=paTrack <noreply@example.com>

# ----- Import by email: a dedicated mailbox read over IMAP every minute -----
# The address shown in the app; forward emails there and their attachments are imported
PATRACK_INBOX_ADDRESS=archivio@example.com
PATRACK_IMAP_HOST=
PATRACK_IMAP_PORT=993
PATRACK_IMAP_USER=
PATRACK_IMAP_PASSWORD=
PATRACK_IMAP_FOLDER=INBOX
# Optional: move handled messages to this folder (it must exist), otherwise they are only marked as read
PATRACK_IMAP_DONE_FOLDER=
# 1 = accept only messages whose sender passed SPF or DKIM (Authentication-Results header of your mail server)
PATRACK_IMAP_REQUIRE_AUTH=1

# ----- Files -----
# Largest file accepted (MB)
PATRACK_MAX_FILE_MB=50
# OCR languages (Tesseract)
PATRACK_OCR_LANGS=ita+eng
# Encryption key of the files. Default: /app/data/.file_key, created on first start. KEEP A COPY ELSEWHERE:
# without it the files cannot be read. `python manage.py export-key` prints it.
# PATRACK_KEY_FILE=/app/data/.file_key

# How many daily automatic database backups to keep on the server
PATRACK_BACKUP_KEEP=30

# ----- weHub: one sign-in and one family for all the family apps (optional) -----
# With these set, sign-in goes only through the OIDC provider (the same Pocket ID as weHub) and the family, its
# members and people are managed in weHub. Key: the same as WEHUB_APP_PATRACK_KEY in weHub.
PATRACK_HUB_URL=
PATRACK_HUB_KEY=
# Address of weHub for people (links), if different from PATRACK_HUB_URL (e.g. an internal Docker address)
PATRACK_HUB_PUBLIC_URL=
