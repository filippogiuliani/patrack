# ===== Pelican – configuration =====

# Public address of the app (email links, the OIDC callback)
PELICAN_URL=https://pelican.example.com

# Time zone
TZ=Europe/Rome

# Sign-up: "open" (anyone) or "closed" (only through an invitation link)
PELICAN_SIGNUP=closed

# In production behind HTTPS: cookies only over secure connections
PELICAN_COOKIE_SECURE=1
# Set to 1 when a reverse proxy sits in front (nginx, Caddy, Traefik…)
PELICAN_PROXY=1
# How long a sign-in lasts on a device (days)
PELICAN_SESSION_DAYS=30

# ----- Sign-in: Pocket ID (the same provider as Kooka and Wallaby) -----
# In Pocket ID: OIDC Clients → Add, callback URL <PELICAN_URL>/api/oidc/pocketid/callback
PELICAN_OIDC=pocketid
PELICAN_OIDC_POCKETID_ISSUER=https://id.example.com
PELICAN_OIDC_POCKETID_ID=
PELICAN_OIDC_POCKETID_SECRET=
PELICAN_OIDC_POCKETID_NAME=Pocket ID
# Email/password sign-in: 0 = only Pocket ID (passkeys, Face ID). Keep 1 until you have signed in once with Pocket ID.
PELICAN_PASSWORD_LOGIN=1

# ----- Email sent by Pelican (address confirmation, import summaries). Without SMTP emails are only logged. -----
PELICAN_SMTP_HOST=
PELICAN_SMTP_PORT=587
PELICAN_SMTP_USER=
PELICAN_SMTP_PASSWORD=
PELICAN_MAIL_FROM=Pelican <noreply@example.com>

# ----- Import by email: a dedicated mailbox read over IMAP every minute -----
# The address shown in the app; forward emails there and their attachments are imported
PELICAN_INBOX_ADDRESS=archivio@example.com
PELICAN_IMAP_HOST=
PELICAN_IMAP_PORT=993
PELICAN_IMAP_USER=
PELICAN_IMAP_PASSWORD=
PELICAN_IMAP_FOLDER=INBOX
# Optional: move handled messages to this folder (it must exist), otherwise they are only marked as read
PELICAN_IMAP_DONE_FOLDER=
# 1 = accept only messages whose sender passed SPF or DKIM (Authentication-Results header of your mail server)
PELICAN_IMAP_REQUIRE_AUTH=1

# ----- Files -----
# Largest file accepted (MB)
PELICAN_MAX_FILE_MB=50
# OCR languages (Tesseract)
PELICAN_OCR_LANGS=ita+eng
# Encryption key of the files. Default: /app/data/.file_key, created on first start. KEEP A COPY ELSEWHERE:
# without it the files cannot be read. `python manage.py export-key` prints it.
# PELICAN_KEY_FILE=/app/data/.file_key

# How many daily automatic database backups to keep on the server
PELICAN_BACKUP_KEEP=30

# ----- Wombat: one sign-in and one family for all the family apps (optional) -----
# With these set, sign-in goes only through the OIDC provider (the same Pocket ID as Wombat) and the family, its
# members and people are managed in Wombat. Key: the same as WOMBAT_APP_PELICAN_KEY in Wombat.
PELICAN_HUB_URL=
PELICAN_HUB_KEY=
# Address of Wombat for people (links), if different from PELICAN_HUB_URL (e.g. an internal Docker address)
PELICAN_HUB_PUBLIC_URL=
