# Copy to scripts/backup.env (it holds secrets: chmod 600, never commit it)

# The Borg repository on the NAS, e.g. over SSH
BORG_REPO=ssh://borg@nas.local/./patrack
# Passphrase of the repository (or use BORG_PASSCOMMAND to read it from a file / password manager)
BORG_PASSPHRASE=change-me
# SSH key dedicated to this backup
BORG_RSH="ssh -i /root/.ssh/patrack_borg -o BatchMode=yes"

# Optional: where paTrack's data is (default: ../paTrack_data) and how to call manage.py (default: in the container)
# PATRACK_DATA_DIR=/srv/patrack/paTrack_data
# PATRACK_MANAGE="docker exec patrack python manage.py"
