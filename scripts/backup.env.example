# Copy to scripts/backup.env (it holds secrets: chmod 600, never commit it)

# The Borg repository on the NAS, e.g. over SSH
BORG_REPO=ssh://borg@nas.local/./pelican
# Passphrase of the repository (or use BORG_PASSCOMMAND to read it from a file / password manager)
BORG_PASSPHRASE=change-me
# SSH key dedicated to this backup
BORG_RSH="ssh -i /root/.ssh/pelican_borg -o BatchMode=yes"

# Optional: where Pelican's data is (default: ../Pelican_data) and how to call manage.py (default: in the container)
# PELICAN_DATA_DIR=/srv/pelican/Pelican_data
# PELICAN_MANAGE="docker exec pelican python manage.py"
